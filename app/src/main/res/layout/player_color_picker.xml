<?xml version="1.0" encoding="utf-8"?>
<!--
  Player colour dialog content. Every dimension is in ART pixels written as px:
  PixelUi.skin multiplies them by the integer scale. The wheel stays smooth on purpose:
  a gradient is the one thing here that should not be pixel art, it is a colour picker.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="1px"
        android:tag="frame" >

        <View
            android:id="@+id/player_color_preview"
            android:layout_width="match_parent"
            android:layout_height="18px" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/player_color_swatches"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6px"
        android:orientation="horizontal" >

        <View
            android:id="@+id/player_color_swatch_0"
            android:layout_width="26px"
            android:layout_height="14px"
            android:layout_marginRight="4px" />

        <View
            android:id="@+id/player_color_swatch_1"
            android:layout_width="26px"
            android:layout_height="14px"
            android:layout_marginRight="4px" />

        <View
            android:id="@+id/player_color_swatch_2"
            android:layout_width="26px"
            android:layout_height="14px"
            android:layout_marginRight="4px" />

        <View
            android:id="@+id/player_color_swatch_3"
            android:layout_width="26px"
            android:layout_height="14px"
            android:layout_marginRight="4px" />

        <View
            android:id="@+id/player_color_swatch_4"
            android:layout_width="26px"
            android:layout_height="14px"
            android:layout_marginRight="4px" />

        <View
            android:id="@+id/player_color_swatch_5"
            android:layout_width="26px"
            android:layout_height="14px"
            android:layout_marginRight="0px" />

    </LinearLayout>

    <com.ridgelineapps.resdicegame.ColorWheelView
        android:id="@+id/player_color_wheel"
        android:layout_width="56px"
        android:layout_height="56px"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8px" />

    <com.ridgelineapps.resdicegame.PixelTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8px"
        android:text="@string/player_color_brightness" />

    <SeekBar
        android:id="@+id/player_color_brightness"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2px"
        android:max="255" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6px"
        android:gravity="center_vertical"
        android:orientation="horizontal" >

        <com.ridgelineapps.resdicegame.PixelTextView
            android:id="@+id/player_color_hex_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="6px"
            android:text="@string/player_color_hex_label" />

        <com.ridgelineapps.resdicegame.PixelEditText
            android:id="@+id/player_color_hex"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="#RRGGBB"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:maxLength="9"
            android:singleLine="true" />
    </LinearLayout>

</LinearLayout>
