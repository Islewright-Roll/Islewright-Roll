<?xml version="1.0" encoding="utf-8"?>
<!--
  Every dimension is in ART pixels written as px: PixelUi.skin multiplies them by the
  integer scale. The root gets the panel frame from skin(). One layout for every screen
  size: sizes are art pixels times the scale, so there is no -small variant.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14px" >

    <com.ridgelineapps.resdicegame.PixelTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:tag="title"
        android:text="@string/high_scores_title" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="2px"
        android:layout_marginBottom="6px"
        android:tag="rule" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0px"
        android:layout_weight="1" />

    <!-- One radio button per map, added in code (HighScores.buildMapToggle). Hidden when
         there is only one map. It heads the list it switches, so it sits with the rows
         below the spacer and not up under the title. -->
    <RadioGroup
        android:id="@+id/high_scores_maps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6px"
        android:layout_marginRight="6px"
        android:orientation="horizontal" />

    <!-- The rule the first row hangs from, like the one under every row -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginLeft="6px"
        android:layout_marginRight="6px"
        android:layout_marginTop="4px"
        android:tag="rule" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6px"
        android:layout_marginRight="6px"
        android:layout_marginTop="8px"
        android:gravity="bottom"
        android:orientation="horizontal" >

        <com.ridgelineapps.resdicegame.PixelTextView
            android:id="@+id/textView1_1"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:tag="title" />

        <com.ridgelineapps.resdicegame.PixelTextView
            android:id="@+id/textView1_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="right" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginLeft="6px"
        android:layout_marginRight="6px"
        android:layout_marginTop="6px"
        android:tag="rule" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6px"
        android:layout_marginRight="6px"
        android:layout_marginTop="8px"
        android:gravity="bottom"
        android:orientation="horizontal" >

        <com.ridgelineapps.resdicegame.PixelTextView
            android:id="@+id/textView2_1"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:tag="title" />

        <com.ridgelineapps.resdicegame.PixelTextView
            android:id="@+id/textView2_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="right" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginLeft="6px"
        android:layout_marginRight="6px"
        android:layout_marginTop="6px"
        android:tag="rule" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6px"
        android:layout_marginRight="6px"
        android:layout_marginTop="8px"
        android:gravity="bottom"
        android:orientation="horizontal" >

        <com.ridgelineapps.resdicegame.PixelTextView
            android:id="@+id/textView3_1"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:tag="title" />

        <com.ridgelineapps.resdicegame.PixelTextView
            android:id="@+id/textView3_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="right" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginLeft="6px"
        android:layout_marginRight="6px"
        android:layout_marginTop="6px"
        android:tag="rule" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6px"
        android:layout_marginRight="6px"
        android:layout_marginTop="8px"
        android:gravity="bottom"
        android:orientation="horizontal" >

        <com.ridgelineapps.resdicegame.PixelTextView
            android:id="@+id/textView4_1"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:tag="title" />

        <com.ridgelineapps.resdicegame.PixelTextView
            android:id="@+id/textView4_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="right" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginLeft="6px"
        android:layout_marginRight="6px"
        android:layout_marginTop="6px"
        android:tag="rule" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6px"
        android:layout_marginRight="6px"
        android:layout_marginTop="8px"
        android:gravity="bottom"
        android:orientation="horizontal" >

        <com.ridgelineapps.resdicegame.PixelTextView
            android:id="@+id/textView5_1"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:tag="title" />

        <com.ridgelineapps.resdicegame.PixelTextView
            android:id="@+id/textView5_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="right" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginLeft="6px"
        android:layout_marginRight="6px"
        android:layout_marginTop="6px"
        android:tag="rule" />

    <com.ridgelineapps.resdicegame.PixelTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20px"
        android:gravity="center_horizontal"
        android:tag="secondary"
        android:text="@string/high_scores_backup_note" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8px"
        android:orientation="horizontal" >

        <com.ridgelineapps.resdicegame.PixelButton
            android:id="@+id/high_scores_export"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/high_scores_export_button" />

        <com.ridgelineapps.resdicegame.PixelButton
            android:id="@+id/high_scores_import"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4px"
            android:text="@string/high_scores_import_button" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0px"
        android:layout_weight="1" />

    <com.ridgelineapps.resdicegame.PixelButton
        android:id="@+id/high_scores_ok"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ok_button" />
</LinearLayout>
