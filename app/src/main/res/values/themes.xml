<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Light and dark are the kit's own, not the platform's: every screen paints its panel
      and its colours from PixelUi.palette(), which follows the Theme setting and the OS
      night mode, so there is no values-night split. The platform theme only supplies what
      the kit does not draw: no action bar, no status bar, a dark window behind the panels
      and a light caret and selection for the hex field, which sits on a dark recess.
    -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">#1E140A</item>
        <item name="android:colorControlActivated">#FFF4D6</item>
        <item name="android:colorControlNormal">#FFF4D6</item>
    </style>

</resources>
