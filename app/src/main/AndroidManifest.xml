<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" >

    <application
        android:name="com.ridgelineapps.resdicegame.GameApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme" >
        <activity
            android:name="com.ridgelineapps.resdicegame.MainActivity"
            android:label="@string/launcher_name"
            android:screenOrientation="portrait"
            android:configChanges="uiMode"
            android:exported="true"
            >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.ridgelineapps.resdicegame.About"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:configChanges="uiMode"
            />
        <activity android:name="com.ridgelineapps.resdicegame.Rules"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:configChanges="uiMode"
            />
        <activity android:name="com.ridgelineapps.resdicegame.HighScores"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:configChanges="uiMode"
            />
        </application>

</manifest>
